{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-atlas.dev/schema/recommendation.schema.json",
  "title": "Recommendation output",
  "description": "The engine's output contract (RECOMMENDATION.md §15). The explanation object is mandatory and machine-generated: a recommendation missing any of its six components does not render.",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "reference_date", "query_echo"],

  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "result": { "enum": ["recommendation", "refusal"] },
    "reference_date": { "$ref": "defs.schema.json#/$defs/date" },
    "criterion": {
      "enum": ["p_best", "expected_value", "minimax_regret"],
      "description": "Selected from persona risk posture unless overridden. Always disclosed — an enterprise team and a solo founder get different answers from identical evidence, and the reader should know why."
    },
    "rng_seed": {
      "type": "integer",
      "description": "Monte Carlo seed, recorded so the run is reproducible (invariant 2)."
    },
    "query_echo": { "type": "object", "description": "What the engine understood the question to be." },

    "refusal": {
      "type": ["object", "null"],
      "required": ["code", "resolves_with"],
      "properties": {
        "code": { "$ref": "defs.schema.json#/$defs/refusalCode" },
        "detail": { "type": "string" },
        "resolves_with": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "What evidence would answer this. Written into the gap register as research tasks — the engine's failures become the research agenda."
        }
      }
    },

    "pareto_set": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Defensible choices established WITHOUT weights (stage 8). Dominance is a fact about the evidence; ranking is a judgment about the reader. The output keeps them separate."
    },

    "stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slots", "coverage", "confidence", "compatibility", "explanation"],
        "properties": {
          "slots": {
            "type": "object",
            "propertyNames": { "$ref": "defs.schema.json#/$defs/slot" },
            "additionalProperties": {
              "type": "array",
              "items": { "$ref": "defs.schema.json#/$defs/entityId" }
            }
          },

          "allocation": {
            "type": "object",
            "description": "Portfolio mix where one dominates any single choice (DECISION.md §11). Marked unvalidated until per-task-class measurements exist.",
            "properties": {
              "shares": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
              "status": { "enum": ["unvalidated", "validated"] },
              "switching_friction_note": { "type": "string" }
            }
          },

          "p_best": {
            "type": ["number", "null"], "minimum": 0, "maximum": 1,
            "description": "Probability this is the best choice for this persona. The headline number when criterion is p_best — a 34-point probability gap means something a '4.2 vs 3.9' does not."
          },

          "max_regret": {
            "type": "object",
            "description": "Worst-case shortfall across sampled states. Units per DECISION.md §4: dollars for cost, natural units for continuous metrics, RANKS or probabilities for ordinal dimensions — never synthetic utility points.",
            "properties": {
              "cost_usd": { "type": "number" },
              "metric_points": { "type": "object" },
              "ordinal_ranks": { "type": "object" }
            }
          },

          "coverage": { "type": "string" },
          "confidence": { "$ref": "defs.schema.json#/$defs/confidence" },
          "compatibility": {
            "enum": ["verified", "partially_unverified", "untested"],
            "description": "'untested' is common early and must never be presented as verified. Absence of a works_with edge is not compatibility."
          },

          "cost": {
            "type": "object",
            "required": ["monthly_usd", "usage_profile", "profile_status", "cost_confidence"],
            "properties": {
              "monthly_usd": { "type": "number", "minimum": 0 },
              "range_usd": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "usage_profile": { "$ref": "defs.schema.json#/$defs/usageProfileId" },
              "profile_status": { "enum": ["assumed", "measured"] },
              "pricing_as_of": { "$ref": "defs.schema.json#/$defs/date" },
              "cost_confidence": { "$ref": "defs.schema.json#/$defs/confidence" },
              "crossover_note": { "type": "string" }
            }
          },

          "position": {
            "type": "object",
            "description": "A stack is a position, not a purchase (DECISION.md §6).",
            "properties": {
              "option_value": { "type": "string" },
              "substitutes_per_slot": { "type": "object" },
              "switching_cost": { "type": "string" },
              "expected_decay": { "type": "string" },
              "horizon_months": { "type": "integer" }
            }
          },

          "ratio_to_frontier": {
            "type": "object",
            "properties": {
              "objective": { "$ref": "defs.schema.json#/$defs/objectiveId" },
              "value": { "type": "number", "minimum": 0, "maximum": 1 },
              "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
              "frontier_as_of": { "$ref": "defs.schema.json#/$defs/date" }
            },
            "description": "Continuous measurements only. Never computed from ordinal rubric scores (invariant 8)."
          },

          "explanation": { "$ref": "#/$defs/explanation" }
        }
      }
    },

    "budget_frontier": {
      "type": "object",
      "description": "DECISION.md §5. Answers 'what does my next dollar buy?' rather than 'what is best at $X'.",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "usd_month": { "type": "number", "minimum": 0 },
              "capability": { "type": "number" },
              "stack_ref": { "type": "string" }
            }
          }
        },
        "knees": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "usd_month": { "type": "number" },
              "note": { "type": "string" }
            }
          },
          "description": "Where marginal return changes sharply. The actionable part of a budget answer."
        },
        "marginal_value_per_dollar": { "type": "number" },
        "dominated_ranges": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Spend ranges where no stack beats a cheaper one. Telling someone their planned spend sits in a dead zone is among the most valuable outputs available."
        }
      }
    },

    "value_of_information": {
      "type": "array",
      "description": "DECISION.md §8. Which unknowns, if resolved, would most change this answer. Feeds the research agenda — and licenses NOT researching the low-value ones.",
      "items": {
        "type": "object",
        "required": ["unknown", "impact"],
        "properties": {
          "unknown": { "type": "string" },
          "impact": { "enum": ["decisive", "high", "moderate", "negligible"] },
          "queries_affected": { "type": "integer" },
          "resolves_with": { "type": "string" }
        }
      }
    },

    "weights_used": { "type": "object" },
    "weights_status": { "const": "opinion" },
    "eliminated": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "constraint": { "type": "string" },
          "removed": { "type": "integer" }
        }
      },
      "description": "Elimination is reported, not silent. A constraint that removed everything is the finding."
    }
  },

  "$defs": {
    "explanation": {
      "type": "object",
      "description": "All six components mandatory (RECOMMENDATION.md §13). Machine-generated from the computation; none hand-written.",
      "additionalProperties": false,
      "required": ["why_won", "assumptions", "tradeoffs_accepted", "evidence",
                   "uncertainty", "what_would_change_it"],
      "properties": {
        "why_won": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["factor", "contribution"],
            "properties": {
              "factor": { "type": "string" },
              "contribution": { "type": "string" },
              "marginal_effect": { "type": "number" }
            }
          },
          "description": "Ranked by marginal effect on the OUTCOME, not a score dump. A factor that did not change the answer does not belong here."
        },

        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["assumption", "editable"],
            "properties": {
              "assumption": { "type": "string" },
              "value": {},
              "source": { "enum": ["persona_default", "query", "system_default", "usage_profile"] },
              "editable": { "type": "boolean" }
            }
          },
          "description": "Most of what determines a recommendation is assumptions the reader never made. Surfacing them as editable turns a verdict into a model they can argue with."
        },

        "tradeoffs_accepted": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gave_up", "versus"],
            "properties": {
              "gave_up": { "type": "string" },
              "versus": { "type": "string" },
              "magnitude": { "type": "string" }
            }
          },
          "description": "What the runner-up was better at, in its own units. The component most systems omit and the one a reader most needs."
        },

        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim"],
            "properties": {
              "claim": { "$ref": "defs.schema.json#/$defs/claimId" },
              "source_class": { "$ref": "defs.schema.json#/$defs/sourceClass" },
              "freshness": { "$ref": "defs.schema.json#/$defs/freshness" }
            }
          }
        },

        "uncertainty": {
          "type": "object",
          "required": ["summary"],
          "properties": {
            "summary": { "type": "string" },
            "p_best": { "type": ["number", "null"] },
            "widest_distributions": { "type": "array", "items": { "type": "string" } },
            "unverified_pairs": { "type": "array", "items": { "type": "string" } },
            "gaps": { "type": "array", "items": { "type": "string" } }
          }
        },

        "what_would_change_it": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["input", "threshold"],
            "properties": {
              "input": { "type": "string" },
              "threshold": { "type": "string" },
              "fragility": { "enum": ["fragile", "moderate", "robust"] }
            }
          },
          "description": "Sensitivity margins (DECISION.md §7). A fragile recommendation is disclosed as fragile; robustness across all plausible weightings is itself a finding."
        }
      }
    }
  }
}
