{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-atlas.dev/schema/relationship.schema.json",
  "title": "Relationship",
  "description": "A typed, evidenced, bitemporal edge (GRAPH.md). Edges are facts and carry the same discipline as claims. Domain/range conformance is checked against data/schema/predicates.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["predicate", "object", "temporal_kind", "temporal", "evidence"],

  "properties": {
    "id": { "$ref": "defs.schema.json#/$defs/relationshipId" },
    "schema_version": { "type": "integer", "const": 1 },

    "predicate": { "$ref": "defs.schema.json#/$defs/relationshipPredicate" },
    "object": {
      "oneOf": [
        { "$ref": "defs.schema.json#/$defs/entityId" },
        { "$ref": "defs.schema.json#/$defs/capabilityId" },
        { "$ref": "defs.schema.json#/$defs/personaId" },
        { "$ref": "defs.schema.json#/$defs/benchmarkId" },
        { "$ref": "defs.schema.json#/$defs/sourceId" }
      ]
    },

    "temporal_kind": { "$ref": "defs.schema.json#/$defs/temporalKind" },
    "temporal": { "$ref": "defs.schema.json#/$defs/temporalInterval" },

    "qualifiers": {
      "type": "object",
      "properties": {
        "default": { "type": "boolean" },
        "spec_version": { "type": "string" },
        "tier": { "type": "string" },
        "region": { "type": "string" },
        "depth": { "type": "integer", "description": "Reseller chain depth for derived R2 edges." }
      }
    },

    "failure_mode": {
      "type": "string",
      "description": "REQUIRED for incompatible_with. An incompatibility without a stated failure mode is a rumour (GRAPH.md §7.7)."
    },

    "co_use_evidence": {
      "type": "string",
      "enum": ["vendor_matrix", "field_reports", "first_party_run"],
      "description": "REQUIRED for works_with. Shared protocol support is NOT admissible — GRAPH.md §6 forbids inferring co-use from protocol support."
    },

    "sampling": {
      "type": "object",
      "description": "REQUIRED for migration_target_of. The strongest adoption signal available, so it carries the highest evidence bar.",
      "required": ["sample_type", "direction"],
      "properties": {
        "sample_type": { "enum": ["recurring-theme", "consensus"] },
        "direction": { "type": "string" },
        "stated_reasons": { "type": "array", "items": { "type": "string" } },
        "population": { "type": "string" },
        "time_window": { "type": "string" }
      }
    },

    "derived": {
      "type": "boolean",
      "default": false,
      "description": "Materialized by an inference rule. Hand-authoring a derived edge fails validation (GRAPH.md §7.11)."
    },
    "derivation_rule": {
      "type": "string",
      "enum": ["R1", "R2", "R3", "R4", "R5", "R6"]
    },

    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/$defs/claimId" }
    },

    "confidence": { "$ref": "defs.schema.json#/$defs/confidence", "readOnly": true }
  },

  "allOf": [
    {
      "if": { "properties": { "predicate": { "const": "works_with" } }, "required": ["predicate"] },
      "then": { "required": ["co_use_evidence"] }
    },
    {
      "if": { "properties": { "predicate": { "const": "incompatible_with" } }, "required": ["predicate"] },
      "then": { "required": ["failure_mode"] }
    },
    {
      "if": { "properties": { "predicate": { "const": "migration_target_of" } }, "required": ["predicate"] },
      "then": { "required": ["sampling"] }
    },
    {
      "if": { "properties": { "derived": { "const": true } }, "required": ["derived"] },
      "then": { "required": ["derivation_rule"] }
    },
    {
      "if": {
        "properties": { "predicate": { "enum": ["recommended_for", "unsuitable_for"] } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "derived": { "const": true },
          "derivation_rule": { "const": "R6" }
        },
        "description": "Recommendation edges are engine output. A hand-authored one is an unscoped opinion (CONSTITUTION §6)."
      }
    }
  ]
}
