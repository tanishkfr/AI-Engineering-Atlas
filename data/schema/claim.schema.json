{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-atlas.dev/schema/claim.schema.json",
  "title": "Claim (temporal fact)",
  "description": "v2. Immutable, bitemporal, append-only. A claim is never edited: changes and corrections append new records with supersession links (TEMPORAL.md). The v1.0 history[] array is retired — history IS the record set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "temporal_kind", "subject", "predicate", "statement",
               "temporal", "evidence", "cadence_days", "status"],

  "properties": {
    "id": { "$ref": "defs.schema.json#/$defs/claimId" },
    "schema_version": { "type": "integer", "const": 2 },

    "type": { "$ref": "defs.schema.json#/$defs/claimType" },
    "temporal_kind": { "$ref": "defs.schema.json#/$defs/temporalKind" },

    "subject": { "$ref": "defs.schema.json#/$defs/entityId" },
    "objects": {
      "type": "array",
      "items": { "$ref": "defs.schema.json#/$defs/entityId" },
      "description": "Required for comparative (C) claims."
    },

    "predicate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "From data/schema/predicates.yaml, which also declares each predicate's temporal_kind."
    },

    "statement": { "type": "string", "minLength": 10 },
    "value": { "description": "Structured where possible. The literal 'unknown' is a legal, publishable value." },

    "temporal": { "$ref": "defs.schema.json#/$defs/temporalInterval" },

    "conditions": {
      "$ref": "defs.schema.json#/$defs/measurementConditions",
      "description": "Mandatory for measurement and series kinds."
    },

    "qualifiers": {
      "type": "object",
      "properties": {
        "via": { "type": ["string", "null"] },
        "region": { "type": "string" },
        "tier": { "type": "string" }
      }
    },

    "supersedes": { "$ref": "defs.schema.json#/$defs/claimId" },
    "superseded_by": { "$ref": "defs.schema.json#/$defs/claimId" },
    "supersession_kind": { "$ref": "defs.schema.json#/$defs/supersessionKind" },
    "supersession_reason": {
      "type": "string",
      "description": "Required for correction and retraction. This is what the corrections register publishes."
    },

    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/$defs/evidenceRef" }
    },

    "conflicts": {
      "type": "array",
      "items": { "$ref": "defs.schema.json#/$defs/conflict" }
    },

    "confidence": { "$ref": "defs.schema.json#/$defs/confidence", "readOnly": true },
    "freshness":  { "$ref": "defs.schema.json#/$defs/freshness", "readOnly": true },

    "cadence_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "status": { "$ref": "defs.schema.json#/$defs/claimStatus" }
  },

  "allOf": [
    {
      "if": { "properties": { "temporal_kind": { "enum": ["measurement", "series"] } }, "required": ["temporal_kind"] },
      "then": {
        "required": ["conditions"],
        "description": "Measurements and series are never carried forward and never render without conditions (TEMPORAL.md §2, §7.1)."
      }
    },
    {
      "if": { "properties": { "supersession_kind": { "enum": ["correction", "retraction"] } }, "required": ["supersession_kind"] },
      "then": {
        "required": ["supersession_reason", "supersedes"],
        "description": "Corrections must say what was wrong. CONSTITUTION §11."
      }
    },
    {
      "if": { "properties": { "type": { "const": "C" } }, "required": ["type"] },
      "then": {
        "required": ["objects"],
        "properties": { "evidence": { "minItems": 2 } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["M", "X"] } }, "required": ["type"] },
      "then": {
        "required": ["qualifiers"],
        "properties": { "qualifiers": { "required": ["via"] } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "F" } }, "required": ["type"] },
      "then": { "properties": { "status": { "const": "draft" } } }
    },
    {
      "if": { "properties": { "temporal_kind": { "enum": ["static", "point"] } }, "required": ["temporal_kind"] },
      "then": {
        "properties": { "cadence_days": { "minimum": 3650 } },
        "description": "Release dates and acquisitions do not decay (TEMPORAL.md §6)."
      }
    }
  ]
}
